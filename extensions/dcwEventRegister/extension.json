{
	"name": "dcwEventRegister",
	"version": "0.1.0",
	"author": [
		"Deoband Community Wikimedia"
	],
	"url": "https://github.com/Deoband-Community-Wikimedia/dcwwiki",
	"descriptionmsg": "dcweventregister-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "specialpage",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\DcwEventRegister\\": "includes/"
	},
	"SpecialPages": {
		"EventRegister": "MediaWiki\\Extension\\DcwEventRegister\\SpecialEventRegister"
	},
	"JobClasses": {
		"dcwSendReminder": "MediaWiki\\Extension\\DcwEventRegister\\SendReminderJob"
	},
	"MessagesDirs": {
		"dcwEventRegister": [
			"i18n"
		]
	},
	"config": {
		"DcwEventRegisterSettings": {
			"value": {
				"senderAddress": "noreply@dcwwiki.org",
				"reminderOffsetMinutes": 30
			}
		}
	},
	"HookHandlers": {
		"dcwEventRegisterHooks": {
			"class": "MediaWiki\\Extension\\DcwEventRegister\\Hooks"
		}
	},
	"Hooks": {
		"LoadExtensionSchemaUpdates": "dcwEventRegisterHooks"
	},
	"manifest_version": 2
}
